# Factorial

fact:
	push eax # Save caller's EAX, ECX
	push ecx
	push ebp # call mechanism
	mov ebp, esp
	mov ebx, 1 # default value = 1
	cmp eax, 1 # n > 1 ?
	jle end_fact # false; leave with default = 1
	mov ecx, eax # true; value = n * fact(n - 1)
	dec eax
	call fact
	mul ebx, ecx
end_fact:
	pop ebp # restore everything; leave
	pop ecx
	pop eax
	ret

start:
	mov eax, 0
loop: inc eax
	call fact
	prn ebx
	cmp eax, 10
	jl loop
